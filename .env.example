# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Assistant (DeepSeek), Telegram Bot & Google OAuth credentials (server/dashboard only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_SUPPORT_TELEGRAM=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployment surface (ADR-0007). Leave unset for a single local deployment
# where the storefront and admin coexist; set it per deployment:
#   storefront -> serve the public shop only; /admin and /auth/* return 404
#   admin      -> serve /admin and /auth/* only (the root redirects to /admin);
#                 everything else returns 404
# NEXT_PUBLIC_APP_MODE=storefront
